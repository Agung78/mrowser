<resources>
    <!-- Capsule address bar: a 44dp round icon button, white disc + dark glyph when focused. -->
    <style name="Widget.Mrowser.BarIcon" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:background">@drawable/bar_icon_bg</item>
        <item name="android:tint">@color/bar_icon_tint</item>
        <item name="android:scaleType">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@animator/bar_focus_scale</item>
    </style>

    <!-- 1×24dp rule between the bar's groups; its margins add to the 4dp item gap. -->
    <style name="Widget.Mrowser.BarSeparator" parent="">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@color/bar_separator</item>
    </style>

    <!-- A pill button (home's History, history's Clear all): the control fill, white with dark
         text and a 1.06 scale when focused. Sentence case, line icon at the start. -->
    <style name="Widget.Mrowser.Pill" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@color/pill_content</item>
        <item name="android:drawableTint">@color/pill_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@animator/pill_focus_scale</item>
    </style>

    <!-- A destructive pill: red text at rest, an accent fill with white text when focused. -->
    <style name="Widget.Mrowser.Pill.Danger">
        <item name="android:background">@drawable/pill_danger_bg</item>
        <item name="android:textColor">@color/pill_danger_content</item>
        <item name="android:drawableTint">@color/pill_danger_content</item>
    </style>
</resources>
